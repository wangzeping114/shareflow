{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=localhost;Database=shareflow;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "SecretKey": "CHANGE_THIS_SECRET_KEY_MIN_32_CHARS!!",
    "Issuer": "ShareFlow",
    "Audience": "ShareFlowClients",
    "AccessTokenExpiryMinutes": 120,
    "RefreshTokenExpiryDays": 7
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "REGION": "overseas",
  "DEFAULT_CURRENCY": "USD",
  "CLIENT_LOCALE": "en-US",
  "ENABLED_PLATFORMS": "YouTube,TikTok,Instagram,Kwai,Xiaohongshu,BrandDeal",
  "YOUTUBE_OAUTH_ENABLED": "true"
}
